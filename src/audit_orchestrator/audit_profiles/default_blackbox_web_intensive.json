        "command": "wfuzz -z file,/usr/share/seclists/Fuzzing/api-endpoints.txt https://{target}:{port}/api/FUZZ -hc 404 --hh BBB 2>&1 || true",
        "description": "API endpoint fuzzing"
      },
      {
        "type": "backup_files",
        "command": "ffuf -u https://{target}:{port}/FUZZ -w /usr/share/seclists/Discovery/Web-Content/raft-large-files-lowercase.txt -mc 200,301,302,403 -e .bak,.old,.backup,.zip,.tar.gz,.sql,.db -t 50 2>&1 || true",
        "description": "Extensive search for backup files and archives"
      },
      {
        "type": "git_exposed",
        "command": "wget --mirror --no-parent https://{target}:{port}/.git/ -P /tmp/git_{target}_{port}/ --no-check-certificate 2>&1 || git-dumper https://{target}:{port}/.git/ /tmp/git_{target}_{port}/ 2>&1 || true",
        "description": "Check for exposed .git directory"
      },
      {
