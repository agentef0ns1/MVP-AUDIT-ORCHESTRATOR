        "command": "curl -sk https://{target}:{port}/.env || curl -sk https://{target}:{port}/.env.local || curl -sk https://{target}:{port}/.env.production || curl -sk https://{target}:{port}/.env.development 2>&1 || true",
        "description": "Check for exposed environment files (multiple variants)"
      },
