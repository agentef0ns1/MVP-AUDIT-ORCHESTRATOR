      {
        "type": "vhost_fuzzing",
        "command": "ffuf -w /usr/share/seclists/Discovery/DNS/subdomains-top1million-10000.txt -u https://{target}:{port}/ -H 'Host: FUZZ.{target}' -mc 200,301,302,401,403 -t 50 2>&1 || true",
        "description": "Extensive virtual host discovery"
      },
