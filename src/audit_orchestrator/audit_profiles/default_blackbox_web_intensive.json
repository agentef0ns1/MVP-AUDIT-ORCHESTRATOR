        "command": "whatweb https://{target}:{port} | grep -iE '(login|signin|auth)' 2>&1 || curl -sk https://{target}:{port} | grep -iE 'type=\"password\"' 2>&1 || true",
        "description": "Detect authentication pages"
      },
