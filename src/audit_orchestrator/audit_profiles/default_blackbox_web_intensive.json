        "command": "graphw00f -t https://{target}:{port}/graphql 2>&1 || curl -k -X POST https://{target}:{port}/graphql -H 'Content-Type: application/json' -d '{\"query\":\"{__schema{types{name}}}\"}' 2>&1 || true",
