      {
        "type": "jenkins_enum",
        "command": "curl -s http://{target}:8080/script 2>&1 || curl -s http://{target}:{port}/jenkins/ 2>&1 || true",
        "description": "Check for Jenkins exposure"
      }
    ],
    "cloud_metadata": [
      {
        "type": "aws_metadata",
        "command": "curl -s http://{target}/latest/meta-data/ --max-time 3 2>&1 || true",
        "description": "Check for AWS metadata service exposure"
      }
    ],
    "default": [
      {
        "type": "nmap_vuln",
        "command": "nmap --script vuln -p {port} {target}",
        "description": "Generic vulnerability scanning"
      },
      {
        "type": "banner_grab",
        "command": "nc -v -n -w 5 {target} {port}",
        "description": "Banner grabbing"
      }
    ]
  },
  "finding_rules": {
    "auto_detect": {
      "anonymous_access": {
        "keywords": ["anonymous", "guest", "unauthenticated"],
        "severity": "medium",
        "cwe": "CWE-306"
      },
      "default_credentials": {
        "keywords": ["default password", "admin:admin", "default credential"],
        "severity": "critical",
        "cwe": "CWE-798"
      },
      "cve_detection": {
        "pattern": "CVE-\\d{4}-\\d{4,7}",
        "severity": "high",
        "cwe": "CWE-1035"
      },
      "ssl_issues": {
        "keywords": ["weak cipher", "ssl vulnerable", "tls deprecated", "expired certificate"],
        "severity": "medium",
        "cwe": "CWE-327"
      },
      "missing_waf": {
        "keywords": ["no waf", "not protected", "no firewall"],
        "severity": "low",
        "cwe": "CWE-693"
      },
      "exposed_secrets": {
        "keywords": ["api_key", "api key", "secret_key", "password", "token", "aws_access", "private_key"],
        "pattern": "(api[_-]?key|secret[_-]?key|password|bearer|token|aws[_-]?access)",
        "severity": "critical",
        "cwe": "CWE-798"
      },
      "exposed_git": {
        "keywords": [".git/config", ".git/HEAD", "git repository"],
        "severity": "high",
        "cwe": "CWE-538"
      },
      "exposed_env_files": {
        "keywords": [".env", "DATABASE_URL", "DB_PASSWORD", "API_SECRET"],
        "severity": "critical",
        "cwe": "CWE-215"
      },
      "backup_files": {
        "keywords": [".bak", ".backup", ".old", ".zip", ".tar.gz"],
        "pattern": "\\.(bak|backup|old|zip|tar\\.gz)$",
        "severity": "medium",
        "cwe": "CWE-538"
      },
      "directory_listing": {
        "keywords": ["Index of /", "Parent Directory", "directory listing"],
        "severity": "medium",
        "cwe": "CWE-548"
      },
      "security_headers_missing": {
        "keywords": ["X-Frame-Options: missing", "Content-Security-Policy: missing", "Strict-Transport-Security: missing"],
        "severity": "low",
        "cwe": "CWE-693"
      },
      "cors_misconfiguration": {
        "keywords": ["Access-Control-Allow-Origin: *", "Access-Control-Allow-Credentials: true"],
        "severity": "medium",
        "cwe": "CWE-942"
      },
      "vulnerable_js_library": {
        "keywords": ["known vulnerabilities", "outdated", "vulnerable version"],
        "severity": "medium",
        "cwe": "CWE-1035"
      },
      "wordpress_vulnerabilities": {
        "keywords": ["WordPress", "plugin vulnerable", "theme vulnerable", "wp version"],
        "severity": "high",
        "cwe": "CWE-1035"
      },
      "cms_detection": {
        "keywords": ["Drupal", "Joomla", "WordPress", "CMS detected"],
        "severity": "info",
        "cwe": "CWE-200"
      },
      "docker_api_exposed": {
        "keywords": ["Docker", "ApiVersion", "Version", "docker daemon"],
        "severity": "critical",
        "cwe": "CWE-306"
      },
      "kubernetes_api_exposed": {
        "keywords": ["kubernetes", "k8s", "pods", "namespaces"],
        "severity": "critical",
        "cwe": "CWE-306"
      },
      "jenkins_exposed": {
        "keywords": ["Jenkins", "hudson", "script console"],
        "severity": "high",
        "cwe": "CWE-306"
      },
      "aws_metadata_exposed": {
        "keywords": ["latest/meta-data", "iam/security-credentials"],
        "severity": "critical",
        "cwe": "CWE-552"
      },
      "smb_null_session": {
        "keywords": ["Anonymous login", "null session", "guest access"],
        "severity": "high",
        "cwe": "CWE-306"
      },
      "smb_signing_disabled": {
        "keywords": ["signing disabled", "not required", "message signing"],
        "severity": "medium",
        "cwe": "CWE-300"
      },
      "database_no_auth": {
        "keywords": ["no authentication", "empty password", "anonymous access"],
        "severity": "critical",
        "cwe": "CWE-306"
      },
      "redis_unprotected": {
        "keywords": ["redis_version", "no password", "protected-mode:no"],
        "severity": "critical",
        "cwe": "CWE-306"
      },
      "mongodb_no_auth": {
        "keywords": ["authorization", "not enabled", "no authentication"],
        "severity": "critical",
        "cwe": "CWE-306"
      },
      "elasticsearch_open": {
        "keywords": ["cluster_name", "status", "indices", "no authentication"],
        "severity": "high",
        "cwe": "CWE-306"
      },
      "graphql_introspection": {
        "keywords": ["__schema", "__type", "introspection enabled"],
        "severity": "low",
        "cwe": "CWE-200"
      },
      "swagger_exposed": {
        "keywords": ["swagger", "openapi", "api-docs"],
        "severity": "low",
        "cwe": "CWE-200"
      }
    }
  },
  "metadata": {
    "version": "1.0",
    "author": "MVP Audit Orchestrator",
    "created": "2026-09-30",
    "scope": "Black-box external network security audit",
    "compliance": [
      "OWASP",
      "SANS Top 25",
      "CWE"
    ]
  }
}
